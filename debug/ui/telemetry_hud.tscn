[ext_resource type="Script" path="res://addons/kinetiforge/debug/ui/telemetry_hud.gd" id="1_script"]

[node name="TelemetryHUD" type="CanvasLayer"]
script = ExtResource("1_script")

[node name="Panel" type="PanelContainer" parent="."]
offset_left = 16.0
offset_top = 16.0
offset_right = 460.0
